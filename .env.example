# HS云盘环境变量模板
# 复制本文件为 .env 并填入真实值

DEPLOY_ROOT=./seafile-custom
FUSE_MOUNT_DIR=./seafile-fuse
SEAFILE_SERVER_VERSION=13.0.25

DB_ROOT_PASSWORD=your-db-root-password
SEAFILE_DB_USER=seafile
SEAFILE_DB_PASSWORD=your-seafile-db-password
SEAFILE_CCNET_DB_NAME=ccnet_db
SEAFILE_SEAFILE_DB_NAME=seafile_db
SEAFILE_SEAHUB_DB_NAME=seahub_db

REDIS_PASSWORD=your-redis-password

SEAFILE_ADMIN_EMAIL=admin
SEAFILE_ADMIN_PASSWORD=your-admin-password

SEAFILE_SERVER_HOSTNAME=10.0.124.98:8088
SEAFILE_SERVER_PROTOCOL=http

# Django Secret Key（用于签名，务必改为随机字符串）
SEAHUB_SECRET_KEY=your-random-secret-key

JWT_PRIVATE_KEY=your-jwt-private-key

ENABLE_SEADOC=false
ENABLE_NOTIFICATION_SERVER=false

SEAFILE_PUBLISH_PORT=8088
SEAFILE_HOST=10.0.124.98:8088
